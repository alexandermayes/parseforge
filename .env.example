# Warcraft Logs API v2 credentials
# Register at https://www.warcraftlogs.com/api/clients
WCL_CLIENT_ID=your_client_id_here
WCL_CLIENT_SECRET=your_client_secret_here

# PostHog analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google AdSense publisher ID — builds the Google Privacy & Messaging CMP script URL.
# Public identifier (appears in every visitor's script URL), not a secret.
NEXT_PUBLIC_GOOGLE_CMP_PUB_ID=pub-XXXXXXXXXXXXXXXX
